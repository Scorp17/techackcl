    clear
    echo -e "\033[1;36m              _____           _     "
    echo -e " |_   _|         | |    "
    echo -e "  | | ___  ____ | |__  \033[1;34m"
    echo -e "  | |/ _ \/ ___||  _ \ "
    echo -e "  | |  __/ |___ | | | |"
    echo -e "  |_|\___|\____||_| |_|"
    echo -e "┌────────────────────────────────────────────┐"
    echo -e "│\033[1;36mAUTOR: \033[1;37mSCOR \033[1;36mPROGRAMADOR: \033[1;37mSCOR\033[1;34m │"
    echo -e "│\033[1;35mIG:    \033[1;37m   \033[1;32mFB:          \033[1;37m\033[1;34m│"
    echo -e "└────────────────────────────────────────────┘\033[0m"
}

baner' > ~/.bashrc

echo -e "\033[1;36mCONCEDIENDO PERMISO\033[0m"
termux-setup-storage

